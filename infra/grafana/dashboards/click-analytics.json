      "description": "SQL: sql/queries/06_countries.sql",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ch"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT\n  country,\n  uniqExact(event_id) AS clicks,\n  round(100 * clicks / sum(clicks) OVER (), 2) AS share_pct\nFROM analytics.clicks\nWHERE $__timeFilter(event_time)\n  AND $__conditionalAll(short_code IN (${short_code:singlequote}), $short_code)\nGROUP BY country\nORDER BY clicks DESC"
        }
      ]
