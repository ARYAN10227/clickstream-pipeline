    {
      "id": 7,
      "title": "End-to-end latency p50 / p95 / p99 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "description": "SQL: sql/queries/07_e2e_latency.sql",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ch"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT\n  time,\n  q[1] AS p50_ms,\n  q[2] AS p95_ms,\n  q[3] AS p99_ms\nFROM\n(\n  SELECT\n    toStartOfMinute(event_time) AS time,\n    quantiles(0.5, 0.95, 0.99)(dateDiff('millisecond', produced_at, ingested_at)) AS q\n  FROM analytics.clicks\n  WHERE $__timeFilter(event_time)\n    AND $__conditionalAll(short_code IN (${short_code:singlequote}), $short_code)\n  GROUP BY time\n)\nORDER BY time"
        }
      ]
    }
