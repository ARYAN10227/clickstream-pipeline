        "query": "SELECT short_code\nFROM analytics.clicks\nWHERE $__timeFilter(event_time)\nGROUP BY short_code\nORDER BY uniqExact(event_id) DESC\nLIMIT 200",
        "definition": "SELECT short_code\nFROM analytics.clicks\nWHERE $__timeFilter(event_time)\nGROUP BY short_code\nORDER BY uniqExact(event_id) DESC\nLIMIT 200",
