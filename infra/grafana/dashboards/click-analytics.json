      "description": "SQL: sql/queries/01_clicks_per_minute.sql",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ch"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT\n  toStartOfMinute(event_time) AS time,\n  uniqExact(event_id) AS clicks\nFROM analytics.clicks\nWHERE $__timeFilter(event_time)\n  AND $__conditionalAll(short_code IN (${short_code:singlequote}), $short_code)\nGROUP BY time\nORDER BY time"
        }
      ]
