{
  "uid": "pipeline-ops",
  "title": "Pipeline Ops",
  "tags": [
    "clickpipe"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Inserted events/s",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(clickpipe_events_inserted_total[1m]))",
          "legendFormat": "inserted/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Consumed vs inserted (events/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(clickpipe_events_consumed_total[1m]))",
          "legendFormat": "consumed"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(clickpipe_events_inserted_total[1m]))",
          "legendFormat": "inserted"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total consumer lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(clickpipe_consumer_lag)",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 4,
      "title": "DLQ rate by reason (records/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (reason) (rate(clickpipe_events_dlq_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "End-to-end latency p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(clickpipe_e2e_latency_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(clickpipe_e2e_latency_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(clickpipe_e2e_latency_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "title": "Insert duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(clickpipe_insert_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "title": "Batch size p50",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(clickpipe_batch_size_bucket[1m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 8,
      "title": "Redpanda produce rate (records/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (redpanda_topic) (rate(redpanda_kafka_records_produced_total{redpanda_namespace=\"kafka\", redpanda_topic=~\"clicks|clicks-dlq\"}[1m]))",
          "legendFormat": "{{redpanda_topic}}"
        }
      ]
    }
  ]
}
